{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dgidb-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"migrations": [
		{
			"new_sqlite_classes": [
				"MyMCP"
			],
			"tag": "v1"
		},
		{
			"tag": "v2-json-to-sql-do",
			"new_sqlite_classes": [
				"JsonToSqlDO"
			]
		},
		{
			"tag": "v3-purge-mymcp",
			"deleted_classes": [
				"MyMCP"
			]
		},
		{
			"tag": "v4-readd-mymcp",
			"new_sqlite_classes": [
				"MyMCP"
			]
		},
		{
			"tag": "mcp-2026-07-28-stateless",
			"deleted_classes": ["MyMCP"]
		},
		{
			"tag": "dgidb-data-do-name-2026-09-30",
			"renamed_classes": [{ "from": "JsonToSqlDO", "to": "DgidbDataDO" }]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DGIDB_DATA_DO",
				"class_name": "DgidbDataDO"
			},

			{
				"name": "WORKSPACE_DO",
				"class_name": "WorkspaceDO",
				"script_name": "workspace-do"
			}
		]
	},
	"alias": {
		"ai": "./src/ai-stub.ts"
	},
	"worker_loaders": [
		{
			"binding": "CODE_MODE_LOADER"
		}
	],
	"observability": {
		"enabled": true
	}
}
